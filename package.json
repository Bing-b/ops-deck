{
  "name": "ops-deck",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first high-contrast desktop workbench for project notes and syntax-highlighted script cards.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start-electron.mjs",
    "serve": "node scripts/serve.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build": "node scripts/build-icon.mjs && vite build && node scripts/build-electron.mjs",
    "pack:win": "pnpm run build && electron-builder --win",
    "typecheck": "vue-tsc --noEmit",
    "test": "node scripts/self-test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.469.0",
    "marked": "^15.0.6",
    "minisearch": "^7.1.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.opsdeck.app",
    "productName": "OpsDeck",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
